{
  "name": "fish-chill-backend",
  "version": "1.0.0",
  "description": "Fish&Chill - Backend Node.js pour suivi des captures, navires, filets et opérations de pêche",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed.js",
    "test": "NODE_ENV=test jest --runInBand --forceExit",
    "test:unit": "NODE_ENV=test jest --runInBand --forceExit tests/unit",
    "test:integration": "NODE_ENV=test jest --runInBand --forceExit tests/integration"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "mqtt": "^5.10.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^1.14.10",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "allowScripts": {
    "mongodb-memory-server@10.4.3": true
  }
}
